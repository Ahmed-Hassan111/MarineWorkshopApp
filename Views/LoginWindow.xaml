<Window x:Class="MarineWorkshopApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام إدارة العمالة" 
        Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Border Background="White" CornerRadius="16" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- زر إغلاق النافذة (X) -->
            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Left" 
                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8" 
                    FontSize="16" Cursor="Hand" Click="CloseButton_Click"/>

            <!-- اللوجو والعنوان -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,30">
                <Border Width="64" Height="64" CornerRadius="12" Background="{StaticResource NavBgBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="⚓" Foreground="White" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="أعالي البحار" FontSize="22" FontWeight="Bold" 
                           Foreground="{StaticResource NavBgBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="" FontSize="10" FontWeight="SemiBold" 
                           Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- نموذج الدخول -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="تسجيل الدخول" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                <TextBlock Text="مرحباً بك مجدداً، يرجى إدخال بياناتك للوصول إلى النظام" 
                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,6,0,25" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- اسم المستخدم -->
                <TextBlock Text="اسم المستخدم" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Margin="0,0,0,16">
                    <TextBox x:Name="TxtUsername" Height="42" VerticalContentAlignment="Center" Padding="10,0" 
                             BorderThickness="0" Background="Transparent" Text="admin"
                             KeyDown="Input_KeyDown"/>
                </Border>

                <!-- كلمة المرور -->
                <TextBlock Text="كلمة المرور" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#F8FAFC" Margin="0,0,0,20">
                    <PasswordBox x:Name="TxtPassword" Height="42" VerticalContentAlignment="Center" Padding="10,0" 
                                 BorderThickness="0" Background="Transparent"
                                 KeyDown="Input_KeyDown"/>
                </Border>

                <!-- زر الدخول -->
                <Button Content="دخول ➔" Style="{StaticResource ActionButtonStyle}" 
                        Height="45" FontSize="15" Click="LoginButton_Click" IsDefault="True"/>
            </StackPanel>

            <!-- الفوتر -->
            <TextBlock Grid.Row="3" Text="🔒 أعالي البحار 2026" 
                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</Window>