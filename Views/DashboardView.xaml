<UserControl x:Class="MarineWorkshopApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 1. Stat Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Content (Table + Recent Activities) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. STAT CARDS ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: إجمالي أجور الأسبوع -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Border Background="#EFF6FF" CornerRadius="8" Width="36" Height="36" DockPanel.Dock="Right">
                            <TextBlock Text="💳" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <Border Background="#DCFCE7" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left" DockPanel.Dock="Left">
                            <TextBlock Text="+12%" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="إجمالي أجور الأسبوع" Foreground="#64748B" FontSize="12" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalWeeklyWages, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text=" ج.م" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: إجمالي السلف -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Border Background="#FEF2F2" CornerRadius="8" Width="36" Height="36" DockPanel.Dock="Right">
                            <TextBlock Text="👛" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <Border Background="#FEF3C7" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left" DockPanel.Dock="Left">
                            <TextBlock Text="+5%" Foreground="#92400E" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="إجمالي السلف" Foreground="#64748B" FontSize="12" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TotalAdvances, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text=" ج.م" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: صافي القبض المتبقي -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Border Background="#F0FDF4" CornerRadius="8" Width="36" Height="36" DockPanel.Dock="Right">
                            <TextBlock Text="💵" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <Border Background="#F1F5F9" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left" DockPanel.Dock="Left">
                            <TextBlock Text="مستقر" Foreground="#475569" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="صافي القبض المتبقي" Foreground="#64748B" FontSize="12" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding NetRemainingPayable, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="#16A34A"/>
                        <TextBlock Text=" ج.م" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 4: عدد العمال النشطين -->
            <Border Grid.Column="6" Background="White" CornerRadius="12" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <Border Background="#F8FAFC" CornerRadius="8" Width="36" Height="36" DockPanel.Dock="Right">
                            <TextBlock Text="👷" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <Border Background="#E0F2FE" CornerRadius="12" Padding="6,2" HorizontalAlignment="Left" DockPanel.Dock="Left">
                            <TextBlock Text="124 عامل" Foreground="#0369A1" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="عدد العمال النشطين اليوم" Foreground="#64748B" FontSize="12" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ActiveWorkersCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text=" عامل اليوم" FontSize="12" Foreground="#64748B" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 2. MAIN CONTENT ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- الجدول البسيط (اليمين) -->
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="20"/>
                <!-- آخر النشاطات (اليسار) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 2.1 جدول ملخص العمال/النشاط -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="ملخص حضور العمالة هذا الأسبوع" FontSize="16" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding WeeklySummaryList}" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9" 
                              Background="Transparent" BorderThickness="0" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود" Binding="{Binding Code}" Width="0.8*"/>
                            <DataGridTextColumn Header="اسم العامل" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="الصنعة" Binding="{Binding Group}" Width="1.2*"/>
                            <DataGridTextColumn Header="أيام الحضور" Binding="{Binding DaysPresent}" Width="*"/>
                            <DataGridTextColumn Header="السُلف" Binding="{Binding Advances, StringFormat='{}{0:N0} ج.م'}" Width="1.2*"/>
                            <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 2.2 آخر النشاطات -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="آخر النشاطات" FontSize="16" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Right"/>
                        <Button Content="عرض الكل" Foreground="#2563EB" Background="Transparent" BorderThickness="0" Cursor="Hand" DockPanel.Dock="Left"/>
                    </DockPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- الأيقونة -->
                                        <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                        </Border>

                                        <!-- التفاصيل -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="13"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- الوقت -->
                                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>