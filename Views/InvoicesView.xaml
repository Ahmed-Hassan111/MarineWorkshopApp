<UserControl x:Class="MarineWorkshopApp.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- نموذج إدخال البنود -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="تفاصيل التصنيع والخدمة" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                <TextBlock Text="اختيار العميل / الشركة" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="CompanyName" 
                          Height="40" Padding="10,0" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="تفاصيل البند (مثال: تصنيع يافطة)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="المقاسات (الطول × العرض) - اختياري" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Dimensions, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="العدد" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="سعر الوحدة (ج.م)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Button Content="➕ إضافة إلى البيان" Style="{StaticResource ActionButtonStyle}" 
                        Command="{Binding AddItemToInvoiceCommand}" Height="45" Margin="0,0,0,15"/>

                <Button Content="🗑️ مسح البيان" Command="{Binding ClearInvoiceCommand}" 
                        Background="#F1F5F9" Foreground="#0F172A" Padding="10,8" BorderThickness="0" Margin="0,0,0,25"/>

                <Separator Margin="0,0,0,20"/>

                <TextBlock Text="إجمالي البيان:" FontSize="13" Foreground="#64748B"/>
                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" Margin="0,4,0,20"/>

                <!-- زرا الحفظ والتحميل فقط -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="🖨️ حفظ وطباعة" Style="{StaticResource ActionButtonStyle}" Background="#0F172A" Command="{Binding SaveAndPrintPdfCommand}"/>
                    <Button Grid.Column="2" Content="📄 تحميل PDF" Style="{StaticResource ActionButtonStyle}" Background="#E2E8F0" Foreground="#0F172A" Command="{Binding DownloadPdfCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- الجانب الأيمن: المعاينة + جداول الفواتير -->
        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="25" BorderBrush="#E2E8F0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- أزرار الأعلى -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔄 استرجاع الفواتير"
                                Command="{Binding LoadAllInvoicesCommand}"
                                Background="#0B2559" Foreground="White"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="12,10" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="🖨️ طباعة PDF للمختار"
                                Command="{Binding PrintSelectedInvoicePdfCommand}"
                                Background="#1D4ED8" Foreground="White"
                                FontSize="13" FontWeight="SemiBold"
                                Padding="12,10" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- ===== جدول كل الفواتير — يظهر فقط عند الضغط على "استرجاع الفواتير" ===== -->
                    <Border Visibility="{Binding ShowAllInvoices, Converter={StaticResource BoolToVis}}"
                            Background="#EFF6FF" CornerRadius="10" Padding="15" Margin="0,0,0,20"
                            BorderBrush="#BFDBFE" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="📂 كل الفواتير المحفوظة" FontSize="14" FontWeight="Bold" Foreground="#1D4ED8" DockPanel.Dock="Right"/>
                                <TextBlock Text="{Binding AllInvoices.Count, StringFormat='({0} فاتورة)'}" FontSize="12" Foreground="#64748B" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding AllInvoices}"
                                      SelectedItem="{Binding SelectedSavedInvoice}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      Background="Transparent" RowHeight="36"
                                      MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="1.5*"/>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding Client.CompanyName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="*"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat='{}{0:N0} ج.م'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- ===== معاينة الفاتورة الحالية ===== -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CompanySettings.WorkshopName}" FontSize="18" FontWeight="Bold" Foreground="#0B2559"/>
                            <TextBlock Text="بيان أعمال تصنيع وتوريد" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Left">
                            <Border Width="70" Height="70" CornerRadius="8" Background="#F8FAFC" Margin="0,0,0,8">
                                <Image Source="{Binding ClientLogoPreview}" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <TextBlock Text="{Binding SelectedClient.CompanyName, FallbackValue='—'}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedClient.OwnerName, StringFormat='المالك: {0}', FallbackValue=''}" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding PreviewInvoiceNumber, StringFormat='بيان أعمال رقم: {0}'}" FontSize="14" FontWeight="Bold" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Separator Margin="0,0,0,15"/>

                    <!-- جدول بنود الفاتورة الحالية -->
                    <DataGrid ItemsSource="{Binding CurrentInvoiceItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                              GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent" RowHeight="40"
                              MinHeight="80">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="البند" Binding="{Binding ItemName}" Width="2*"/>
                            <DataGridTextColumn Header="المقاسات" Binding="{Binding Dimensions}" Width="1.5*"/>
                            <DataGridTextColumn Header="العدد" Binding="{Binding Quantity}" Width="*"/>
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat='{}{0:N0} ج.م'}" Width="*"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat='{}{0:N0} ج.م'}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Left" Margin="0,15,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="الإجمالي الكلي: " Width="120" FontSize="16" FontWeight="Bold" Foreground="#0B2559"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== آخر 10 فواتير — تظهر دائماً تلقائياً ===== -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="15" Margin="0,0,0,0"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="🕐 آخر الفواتير المحفوظة" FontSize="13" FontWeight="Bold" Foreground="#0B2559" DockPanel.Dock="Right"/>
                                <TextBlock Text="(أحدث 10 فواتير)" FontSize="11" Foreground="#94A3B8" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding RecentInvoices}"
                                      SelectedItem="{Binding SelectedSavedInvoice}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      Background="Transparent" RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="1.5*"/>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding Client.CompanyName}" Width="1.5*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="*"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat='{}{0:N0} ج.م'}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
