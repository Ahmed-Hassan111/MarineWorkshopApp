<UserControl x:Class="MarineWorkshopApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Width="600">
        <Border Background="White" CornerRadius="12" Padding="30">
            <StackPanel>
                <TextBlock Text="⚙️ إعدادات الورشة والشركة" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>

                <!-- اسم الورشة / الشركة -->
                <TextBlock Text="اسم المنشأة / الورشة" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox Text="{Binding CurrentSettings.WorkshopName, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- الوصف الفرعي -->
                <TextBlock Text="الوصف الفرعي (يظهر في الهيدر)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox Text="{Binding CurrentSettings.Subtitle, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- العنوان -->
                <TextBlock Text="العنوان الفرعي أو المقر الرئيسي" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox Text="{Binding CurrentSettings.Address, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- العملة المستخدمة -->
                <TextBlock Text="رمز العملة (مثال: ج.م / ر.س)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <TextBox Text="{Binding CurrentSettings.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <!-- مسار اللوجو -->
                <TextBlock Text="شعار الشركة (اللوجو)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding CurrentSettings.LogoPath}" IsReadOnly="True" Height="40" Padding="10,0" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="اختيار صورة..." Style="{StaticResource ActionButtonStyle}" Background="#E2E8F0" Foreground="#0F172A" Command="{Binding BrowseLogoCommand}"/>
                </Grid>

                <!-- زر الحفظ -->
                <Button Content="💾 حفظ التغييرات" Style="{StaticResource ActionButtonStyle}" Height="45" Command="{Binding SaveSettingsCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>