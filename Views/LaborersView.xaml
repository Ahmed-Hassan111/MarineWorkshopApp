<UserControl x:Class="MarineWorkshopApp.Views.LaborersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="10">
        <TabControl Background="White" BorderThickness="0">

            <!-- TAB 1: إدارة العمال (بيانات أساسية) -->
            <TabItem Header="👷 بيانات العمال" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- نموذج إضافة / تعديل عامل -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8,5" Margin="0,0,10,0" Tag="اسم العامل..."/>

                            <TextBox Grid.Column="1" Text="{Binding NewGroup, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8,5" Margin="0,0,10,0" Tag="المجموعة / الصنعة..."/>

                            <TextBox Grid.Column="2" Text="{Binding NewDailyRate, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8,5" Margin="0,0,10,0" Tag="أجر اليوم..."/>

                            <TextBox Grid.Column="3" Text="{Binding NewHourlyOvertimeRate, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="8,5" Margin="0,0,10,0" Tag="أجر ساعة السهرة..."/>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Content="حفظ / إضافة" Style="{StaticResource ActionButtonStyle}" 
                                        Command="{Binding SaveLaborerCommand}" Margin="0,0,5,0"/>
                                <Button Content="مسح الحقول" Command="{Binding ClearFormCommand}" Padding="10,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- شريط البحث والحذف -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="🗑️ حذف العامل المحدد" DockPanel.Dock="Left" 
                                Command="{Binding DeleteLaborerCommand}" Background="#EF4444" Foreground="White" 
                                Padding="10,5" BorderThickness="0"/>

                        <TextBox Width="250" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 DockPanel.Dock="Right" Padding="8,5" Tag="بحث باسم العامل..."/>
                    </DockPanel>

                    <!-- جدول العمال -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Laborers}" SelectedItem="{Binding SelectedLaborer}"
                              AutoGenerateColumns="False" IsReadOnly="True" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود" Binding="{Binding Code}" Width="0.8*"/>
                            <DataGridTextColumn Header="اسم العامل" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="المجموعة / الصنعة" Binding="{Binding GroupName}" Width="1.5*"/>
                            <DataGridTextColumn Header="اليومية (ج.م)" Binding="{Binding DailyRate, StringFormat='{}{0:N0}'}" Width="*"/>
                            <DataGridTextColumn Header="أجر السهرة/ساعة" Binding="{Binding HourlyOvertimeRate, StringFormat='{}{0:N0}'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: تسجيل حضور وأيام العمل -->
            <TabItem Header="📅 سجل الأيام والسهرات" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{Binding Laborers}" SelectedItem="{Binding WorkLogSelectedLaborer}" 
                                      DisplayMemberPath="Name" Margin="0,0,10,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding LogDate}" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="2" Text="{Binding WorkDaysCount}" Padding="8,5" Margin="0,0,10,0" Tag="عدد الأيام (مثال: 1 أو 0.5)"/>
                            <TextBox Grid.Column="3" Text="{Binding OvertimeHours}" Padding="8,5" Margin="0,0,10,0" Tag="ساعات السهرة"/>

                            <Button Grid.Column="4" Content="تسجيل اليومية" Command="{Binding AddWorkLogCommand}" Style="{StaticResource ActionButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- جدول سجل الأيام -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WorkLogs}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                            <DataGridTextColumn Header="اسم العامل" Binding="{Binding LaborerName}" Width="2*"/>
                            <DataGridTextColumn Header="الأيام" Binding="{Binding Days}" Width="*"/>
                            <DataGridTextColumn Header="ساعات السهرة" Binding="{Binding Overtime}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي اليوم" Binding="{Binding DayTotal, StringFormat='{}{0:N0} ج.م'}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: السُلف والحساب الأسبوعي -->
            <TabItem Header="💰 السُلف والتقفيل الأسبوعي" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- تسجيل سلفة -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{Binding Laborers}" SelectedItem="{Binding AdvanceSelectedLaborer}" 
                                      DisplayMemberPath="Name" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding AdvanceAmount}" Padding="8,5" Margin="0,0,10,0" Tag="مبلغ السلفة..."/>
                            <TextBox Grid.Column="2" Text="{Binding AdvanceNotes}" Padding="8,5" Margin="0,0,10,0" Tag="ملاحظات / بيان..."/>

                            <Button Grid.Column="3" Content="تسجيل سلفة" Command="{Binding AddAdvanceCommand}" Background="#DC2626" Foreground="White" Padding="15,5"/>
                        </Grid>
                    </Border>

                    <!-- ملخص المستحقات الأسبوعية لكل عامل -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WeeklySettlements}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="العامل" Binding="{Binding LaborerName}" Width="2*"/>
                            <DataGridTextColumn Header="إجمالي الأيام" Binding="{Binding TotalDays}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي السهرات" Binding="{Binding TotalOvertimeHours}" Width="*"/>
                            <DataGridTextColumn Header="إجمالي المستحق" Binding="{Binding GrossAmount, StringFormat='{}{0:N0} ج.م'}" Width="1.2*"/>
                            <DataGridTextColumn Header="إجمالي السُلف" Binding="{Binding TotalAdvances, StringFormat='{}{0:N0} ج.م'}" Foreground="#DC2626" Width="1.2*"/>
                            <DataGridTextColumn Header="الصافي للقبض" Binding="{Binding NetPayable, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- زر التقفيل -->
                    <Button Grid.Row="2" Content="🔒 تقفيل وتصفية الأسبوع الحالي" 
                            Command="{Binding CloseWeeklySettlementCommand}" 
                            HorizontalAlignment="Left" Margin="0,15,0,0" Padding="20,10" 
                            Background="#0F172A" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>