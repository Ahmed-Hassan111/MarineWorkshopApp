<UserControl x:Class="MarineWorkshopApp.Views.LaborersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">

    <Grid Margin="10">
        <TabControl Background="White" BorderThickness="0">

            <!-- TAB 1: إدارة العمال (بيانات أساسية) -->
            <TabItem Header="👷 بيانات العمال" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- نموذج إضافة / تعديل عامل -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="إضافة / تعديل بيانات عامل" FontSize="13" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Labels للحقول -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="👤 اسم العامل"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="الاسم الكامل للعامل"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="🔧 المجموعة / الصنعة"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="القسم أو نوع العمل الذي ينتمي إليه العامل"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="💰 اليومية (ج.م)"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="أجر اليوم الكامل بالجنيه المصري"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="⏰ أجر ساعة السهرة"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="مبلغ أجر كل ساعة عمل إضافي (سهرة) بالجنيه المصري"/>

                                <!-- Inputs -->
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="اكتب اسم العامل كاملا..."
                                         ToolTip="اسم العامل الذي يظهر في كل التقارير"/>

                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding NewGroup, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="مثال: نجارة / حدادة / طلاء..."
                                         ToolTip="اسم المجموعة أو الصنعة (مثل: نجارة، حدادة، كهرباء)"/>

                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding NewDailyRate, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="مثال: 200"
                                         ToolTip="أجر اليوم الكامل بالجنيه المصري"/>

                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Text="{Binding NewHourlyOvertimeRate, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="مثال: 30"
                                         ToolTip="مبلغ أجر كل ساعة سهرة بالجنيه"/>

                                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                                    <Button Content="💾 حفظ / إضافة" Style="{StaticResource ActionButtonStyle}"
                                            Command="{Binding SaveLaborerCommand}" Margin="0,0,5,0"
                                            ToolTip="إضافة عامل جديد أو تعديل بيانات العامل المحدد"/>
                                    <Button Content="مسح الحقول" Command="{Binding ClearFormCommand}" Padding="10,6"
                                            ToolTip="مسح جميع الحقول وإلغاء التحديد"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- شريط البحث -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="🔍 بحث:" VerticalAlignment="Center" FontSize="12"
                                       FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                            <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,5"
                                     Tag="ابحث باسم العامل أو الكود..."
                                     ToolTip="اكتب اسم العامل أو كوده للبحث"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- جدول العمال -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Laborers}" SelectedItem="{Binding SelectedLaborer}"
                              AutoGenerateColumns="False" IsReadOnly="False" RowHeight="42"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="1" BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="🔢 كود" Binding="{Binding Code}" Width="0.7*" IsReadOnly="True"
                                               ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                            <DataGridTextColumn Header="👤 اسم العامل" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="🔧 المجموعة / الصنعة" Binding="{Binding GroupName}" Width="1.5*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="💰 اليومية (ج.م)" Binding="{Binding DailyRate, StringFormat='{}{0:N0}'}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="⏰ أجر ساعة السهرة" Binding="{Binding HourlyOvertimeRate, StringFormat='{}{0:N0}'}" Width="*" IsReadOnly="True"/>
                            <!-- عمود أزرار التعديل / الحذف -->
                            <DataGridTemplateColumn Header="خيارات" Width="120" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="✏️ تعديل"
                                                    Command="{Binding DataContext.SelectLaborerForEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3" Margin="0,0,4,0"
                                                    Background="#3B82F6" Foreground="White"
                                                    BorderThickness="0" FontSize="11"
                                                    ToolTip="انقر لتحميل بيانات هذا العامل في الحقول أعلاه لتعديله"/>
                                            <Button Content="🗑️ حذف"
                                                    Command="{Binding DataContext.DeleteLaborerByItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3"
                                                    Background="#EF4444" Foreground="White"
                                                    BorderThickness="0" FontSize="11"
                                                    ToolTip="حذف هذا العامل نهائياً مع جميع سجلاته"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: تسجيل حضور وأيام العمل -->
            <TabItem Header="📅 سجل الأيام والسهرات" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تسجيل يومية عامل" FontSize="13" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Labels -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="👤 اختر العامل"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="اسم العامل الذي تريد تسجيل يوميته"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="📅 تاريخ اليوم"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="تاريخ اليوم المراد تسجيل الحضور فيه"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="📆 عدد الأيام"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="عدد أيام الحضور: 1 = يوم كامل، 0.5 = نصف يوم، 0 = غياب"/>
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Text="⏰ ساعات السهرة"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="عدد ساعات العمل الإضافي (سهرة) بعد انتهاء وقت العمل الأساسي"/>

                                <!-- Inputs -->
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          ItemsSource="{Binding Laborers}"
                                          SelectedItem="{Binding WorkLogSelectedLaborer}"
                                          DisplayMemberPath="Name" Margin="0,0,10,0"
                                          ToolTip="اختر اسم العامل المراد تسجيل يوميته"/>
                                <DatePicker Grid.Row="1" Grid.Column="1"
                                            SelectedDate="{Binding LogDate}" Margin="0,0,10,0"
                                            ToolTip="حدد تاريخ اليومية - افتراضياً اليوم الحالي"/>
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding WorkDaysCount}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="1 = يوم كامل, 0.5 = نصف"
                                         ToolTip="ادخل 1 ليوم كامل، 0.5 لنصف يوم، 0 لتسجيل غياب"/>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Text="{Binding OvertimeHours}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="مثال: 2 ساعة"
                                         ToolTip="عدد ساعات السهرة - سيتم ضربها في أجر ساعة السهرة المحدد للعامل"/>

                                <Button Grid.Row="1" Grid.Column="4"
                                        Content="✅ تسجيل اليومية"
                                        Command="{Binding AddWorkLogCommand}"
                                        Style="{StaticResource ActionButtonStyle}"
                                        ToolTip="حفظ اليومية وساعات السهرة للعامل المحدد"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- جدول سجل الأيام (الأسبوع الحالي) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding WorkLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="1" BorderBrush="#E2E8F0"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="📅 التاريخ" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}" Width="*"/>
                            <DataGridTextColumn Header="👤 اسم العامل" Binding="{Binding LaborerName}" Width="2*"/>
                            <DataGridTextColumn Header="📆 عدد الأيام" Binding="{Binding Days}" Width="*"/>
                            <DataGridTextColumn Header="⏰ ساعات السهرة" Binding="{Binding Overtime}" Width="*"/>
                            <DataGridTextColumn Header="💰 إجمالي اليوم" Binding="{Binding DayTotal, StringFormat='{}{0:N0} ج.م'}" Width="*"
                                               FontWeight="SemiBold"/>
                            <!-- عمود أزرار التعديل / الحذف -->
                            <DataGridTemplateColumn Header="خيارات" Width="120" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="✏️ تعديل"
                                                    Command="{Binding DataContext.EditWorkLogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3" Margin="0,0,4,0"
                                                    Background="#3B82F6" Foreground="White"
                                                    BorderThickness="0" FontSize="11"
                                                    ToolTip="تحميل بيانات هذا السجل في الحقول أعلاه لتعديله"/>
                                            <Button Content="🗑️ حذف"
                                                    Command="{Binding DataContext.DeleteWorkLogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3"
                                                    Background="#EF4444" Foreground="White"
                                                    BorderThickness="0" FontSize="11"
                                                    ToolTip="حذف هذا السجل نهائياً"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: السُلف والحساب الأسبوعي -->
            <TabItem Header="💰 السُلف والتقفيل الأسبوعي" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- تسجيل سلفة -->
                    <Border Grid.Row="0" Background="#FFF7F7" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                            BorderBrush="#FCA5A5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تسجيل سلفة" FontSize="13" FontWeight="Bold"
                                       Foreground="#DC2626" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Labels -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="👤 اختر العامل"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="اسم العامل الذي تريد تسجيل سلفة باسمه"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="💵 مبلغ السلفة (ج.م)"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="المبلغ النقدي المصروف للعامل كسلفة ويخصم من مستحقاته"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="📝 ملاحظات / سبب السلفة"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                           Margin="0,0,10,4"
                                           ToolTip="وصف اختياري لسبب السلفة أو أي ملاحظات إضافية"/>

                                <!-- Inputs -->
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          ItemsSource="{Binding Laborers}"
                                          SelectedItem="{Binding AdvanceSelectedLaborer}"
                                          DisplayMemberPath="Name" Margin="0,0,10,0"
                                          ToolTip="اختر اسم العامل من القائمة"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding AdvanceAmount}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="مثال: 500"
                                         ToolTip="ادخل مبلغ السلفة بالجنيه - سيخصم من مستحقات العامل عند التقفيل"/>
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding AdvanceNotes}"
                                         Padding="8,6" Margin="0,0,10,0"
                                         Tag="مثال: سلفة طوارئ..."
                                         ToolTip="بيان اختياري - سبب أو وصف السلفة"/>

                                <Button Grid.Row="1" Grid.Column="3"
                                        Content="💸 تسجيل سلفة"
                                        Command="{Binding AddAdvanceCommand}"
                                        Background="#DC2626" Foreground="White" Padding="15,6"
                                        ToolTip="حفظ السلفة - ستظهر في جدول التقفيل الأسبوعي"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ======= بطاقات إجماليات السلف ======= -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="1.3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- بطاقة: إجمالي كل السلف -->
                        <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="10" Padding="18,14"
                                BorderBrush="#FCA5A5" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="💸 إجمالي كل السلف (جميع العمال)"
                                           FontSize="13" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,10"/>
                                <Button Content="🔍 احسب الإجمالي الكلي للسلف"
                                        Command="{Binding ShowTotalAllAdvancesCommand}"
                                        Background="#DC2626" Foreground="White"
                                        FontSize="12" FontWeight="SemiBold"
                                        Padding="14,8" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="7"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Border Background="#FFF" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding TotalAllAdvancesText.Length, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="{Binding TotalAllAdvancesText}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#7F1D1D"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- بطاقة: إجمالي سلف عامل معين -->
                        <Border Grid.Column="2" Background="#FFF7ED" CornerRadius="10" Padding="18,14"
                                BorderBrush="#FDBA74" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="👤 إجمالي سلف عامل معين"
                                           FontSize="13" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding Laborers}"
                                              SelectedItem="{Binding SelectedAdvanceSummaryLaborer}"
                                              DisplayMemberPath="Name"
                                              Height="36" Padding="8,0" VerticalContentAlignment="Center"
                                              ToolTip="اختر العامل لعرض إجمالي سلفه"/>
                                    <Button Grid.Column="2"
                                            Content="🔍 عرض"
                                            Command="{Binding ShowLaborerTotalAdvancesCommand}"
                                            Background="#EA580C" Foreground="White"
                                            FontSize="12" FontWeight="SemiBold"
                                            Padding="14,8" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="7"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                                <Border Background="#FFF" CornerRadius="6" Padding="10,8"
                                        Visibility="{Binding LaborerAdvancesTotalText.Length, Converter={StaticResource CountToVisibilityConverter}}">
                                    <TextBlock Text="{Binding LaborerAdvancesTotalText}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#78350F"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ملخص المستحقات الأسبوعية لكل عامل -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding WeeklySettlements}" AutoGenerateColumns="False" IsReadOnly="True"
                              RowHeight="40" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="1" BorderBrush="#E2E8F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="👤 العامل" Binding="{Binding LaborerName}" Width="2*"/>
                            <DataGridTextColumn Header="📆 إجمالي الأيام" Binding="{Binding TotalDays}" Width="*"/>
                            <DataGridTextColumn Header="⏰ إجمالي ساعات السهرة" Binding="{Binding TotalOvertimeHours}" Width="*"/>
                            <DataGridTextColumn Header="💰 إجمالي المستحق" Binding="{Binding GrossAmount, StringFormat='{}{0:N0} ج.م'}" Width="1.2*"/>
                            <DataGridTextColumn Header="💸 إجمالي السُلف" Binding="{Binding TotalAdvances, StringFormat='{}{0:N0} ج.م'}" Foreground="#DC2626" Width="1.2*"/>
                            <DataGridTextColumn Header="✅ صافي المستحق" Binding="{Binding NetPayable, StringFormat='{}{0:N0} ج.م'}" FontWeight="Bold" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- زر التقفيل -->
                    <StackPanel Grid.Row="3" Margin="0,15,0,0">
                        <TextBlock Text="⚠️ تقفيل الأسبوع: يؤدي إلى أرشفة جميع سجلات الأيام والسلف المفتوحة ولا يمكن التراجع"
                                   FontSize="11" Foreground="#B45309" Margin="0,0,0,8"
                                   ToolTip="بعد التقفيل ستبدأ الدورة الأسبوعية الجديدة من صفر"/>
                        <Button Content="🔒 تقفيل وتصفية الأسبوع الحالي"
                                Command="{Binding CloseWeeklySettlementCommand}"
                                HorizontalAlignment="Left" Padding="20,10"
                                Background="#0F172A" Foreground="White" FontSize="14" FontWeight="Bold"
                                ToolTip="تقفيل الأسبوع وأرشفة جميع سجلات الحضور والسلف - دورة جديدة من الصفر"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>